# GEMINI_API_KEY: Chave da API Gemini para ativar a consultoria jurídica inteligente com IA.
# Quando configurada, ativa automaticamente o Modo IA na aplicação (estratégias, teses e leis aplicáveis).
# Obtenha sua chave gratuita em: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# APP_URL: URL onde o aplicativo está hospedado (opcional)
APP_URL="http://localhost:3000"

